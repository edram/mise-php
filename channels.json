{
  "minimal": {
    "description": "Smaller Composer-ready CLI build with OpenSSL and ZIP support",
    "gnu_glibc": "2.17",
    "extensions": [
      "iconv",
      "pcntl",
      "posix",
      "mbstring",
      "filter",
      "tokenizer",
      "phar",
      "openssl",
      "zip"
    ],
    "build_options": [],
    "upx": true
  },
  "common": {
    "description": "CLI build with database, network, image, XML, archive, and Redis support",
    "gnu_glibc": "2.17",
    "extensions": [
      "bcmath",
      "bz2",
      "calendar",
      "ctype",
      "curl",
      "dom",
      "exif",
      "fileinfo",
      "filter",
      "ftp",
      "gd",
      "gmp",
      "iconv",
      "xml",
      "mbstring",
      "mbregex",
      "mysqlnd",
      "openssl",
      "pcntl",
      "pdo",
      "pdo_mysql",
      "pdo_sqlite",
      "pdo_pgsql",
      "pgsql",
      "phar",
      "posix",
      "redis",
      "session",
      "simplexml",
      "soap",
      "sockets",
      "sqlite3",
      "tokenizer",
      "xmlwriter",
      "xmlreader",
      "zlib",
      "zip"
    ],
    "build_options": [
      "--with-suggests"
    ],
    "upx": true
  },
  "laravel": {
    "description": "Herd-inspired CLI build for Laravel applications",
    "gnu_glibc": "2.25",
    "shared_extensions": {
      "gnu": [
        "sqlsrv",
        "pdo_sqlsrv"
      ]
    },
    "extensions": [
