#!/usr/bin/env bash
#MISE description="Test version discovery, installation, and execution"
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_dir="$(mktemp -d)"
project_dir="$test_dir/project"
trap 'rm -rf "$test_dir"' EXIT

export MISE_CACHE_DIR="$test_dir/cache"
export MISE_CONFIG_DIR="$test_dir/config"
export MISE_DATA_DIR="$test_dir/data"
export MISE_EXPERIMENTAL=1
export MISE_STATE_DIR="$test_dir/state"
export MISE_USE_VERSIONS_HOST=0

lua - "$root_dir" <<'LUA'
local root_dir = assert(arg[1])
PLUGIN = { version = "test" }
local php = dofile(root_dir .. "/lib/php.lua")

local sapi, channel = php.parse_tool("cli-common")
assert(sapi == "cli")
assert(channel == "common")

local runtime
sapi, channel, runtime = php.parse_tool("cli-laravel-gnu")
assert(sapi == "cli")
assert(channel == "laravel")
assert(runtime == "gnu")

sapi, channel = php.parse_tool("cli-future-channel")
assert(sapi == "cli")
assert(channel == "future-channel")

for _, tool in ipairs({ "cli", "cli-", "cli-../laravel", "cli-laravel.*", "cli-Laravel", "fpm-common" }) do
    local valid, validation_error = pcall(php.parse_tool, tool)
    assert(not valid)
    assert(tostring(validation_error):match("Unsupported PHP tool"))
end

assert(php.tag("8.5.9", "cli", "common") == "php-8.5.9-cli-common")
assert(
    php.archive_name("8.5.9", "cli", "common", "linux", "x86_64")
        == "php-8.5.9-cli-common-linux-x86_64.tar.gz"
)
assert(
    php.archive_name("8.5.9", "cli", "laravel", "linux", "x86_64", "gnu")
        == "php-8.5.9-cli-laravel-linux-x86_64-gnu.tar.gz"
)
local macos_gnu_ok, macos_gnu_error = pcall(
    php.archive_name,
    "8.5.9",
    "cli",
    "laravel",
    "macos",
    "aarch64",
    "gnu"
)
assert(not macos_gnu_ok)
assert(tostring(macos_gnu_error):match("GNU PHP builds are only available on Linux"))

local linux_archive = "php-8.5.9-cli-common-linux-x86_64.tar.gz"
local macos_archive = "php-8.5.9-cli-common-macos-aarch64.tar.gz"
local release = {
    assets = {
        { name = linux_archive, digest = "sha256:" .. string.rep("a", 64) },
        { name = macos_archive, digest = "sha256:" .. string.rep("B", 64) },
        { name = "invalid.tar.gz", digest = "md5:" .. string.rep("c", 32) },
    },
}

assert(php.release_asset_sha256(release, linux_archive) == string.rep("a", 64))
assert(php.release_asset_sha256(release, macos_archive) == string.rep("b", 64))
assert(php.release_asset_sha256(release, "invalid.tar.gz") == nil)
assert(php.release_asset_sha256(release, "missing.tar.gz") == nil)

local existing_files = {
    ["/opt/php/bin/conf.d/20-sqlsrv.ini"] = true,
}
package.preload.file = function()
    return {
        exists = function(path)
            return existing_files[path] == true
        end,
        join_path = function(...)
            return table.concat({ ... }, "/")
        end,
    }
end
package.loaded.file = nil
dofile(root_dir .. "/hooks/backend_exec_env.lua")

local function env_value(env_vars, key)
    for _, entry in ipairs(env_vars) do
        if entry.key == key then
            return entry.value
        end
    end

    return nil
end

local sqlsrv_env = PLUGIN:BackendExecEnv({ install_path = "/opt/php" }).env_vars
assert(env_value(sqlsrv_env, "PATH") == "/opt/php/bin")
assert(env_value(sqlsrv_env, "MISE_PHP_EXTENSION_DIR") == "/opt/php/bin/extensions")
assert(env_value(sqlsrv_env, "PHP_INI_SCAN_DIR") == ":/opt/php/bin/conf.d")

existing_files["/opt/php/bin/conf.d/20-sqlsrv.ini"] = nil
local default_env = PLUGIN:BackendExecEnv({ install_path = "/opt/php" }).env_vars
assert(#default_env == 1)
assert(env_value(default_env, "PATH") == "/opt/php/bin")
LUA

mise_without_config() {
    mise --no-config "$@"
}

mise_test() {
    mise -C "$project_dir" "$@"
}

mise_without_config plugins link --force php "$root_dir"

if mise_without_config ls-remote php:unsupported > /dev/null 2>&1; then
    echo "Unsupported PHP tools must be rejected" >&2
    exit 1
fi

mkdir -p "$project_dir"
printf '%s\n' \
    '[tools]' \
    '"php:cli-common" = "8.5"' \
    > "$project_dir/mise.toml"
mise_test trust

version="$(mise_test ls-remote php:cli-common | tail -n 1)"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Invalid PHP version returned by the plugin: $version" >&2
    exit 1
fi

mise_test install

install_path="$(mise_test where php:cli-common)"
if [[ "$install_path" != "$MISE_DATA_DIR/installs/php-cli-common/"* ]]; then
    echo "PHP common channel used an unexpected install path: $install_path" >&2
    exit 1
fi
if [[ ! -x "$install_path/bin/php" ]]; then
    echo "PHP was not installed at $install_path/bin/php" >&2
    exit 1
fi

installed_version="$(mise_test exec -- php -r 'echo PHP_VERSION;')"
if [[ "$installed_version" != "$version" ]]; then
    echo "Expected PHP $version, got $installed_version" >&2
    exit 1
fi

composer_version="$(mise_test exec -- composer --version --no-ansi)"
if [[ ! "$composer_version" =~ ^Composer\ version\ 2\. ]]; then
    echo "Invalid Composer version: $composer_version" >&2
    exit 1
fi

echo "Installed PHP $installed_version and $composer_version"
