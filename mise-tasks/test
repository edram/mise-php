#!/usr/bin/env bash
#MISE description="Test version discovery, installation, and execution"
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_dir="$(mktemp -d)"
trap 'rm -rf "$test_dir"' EXIT

export MISE_CACHE_DIR="$test_dir/cache"
export MISE_CONFIG_DIR="$test_dir/config"
export MISE_DATA_DIR="$test_dir/data"
export MISE_EXPERIMENTAL=1
export MISE_STATE_DIR="$test_dir/state"
export MISE_USE_VERSIONS_HOST=0

mise_test() {
    mise --no-config "$@"
}

mise_test plugins link --force php "$root_dir"

if mise_test ls-remote php:unsupported > /dev/null 2>&1; then
    echo "Unsupported PHP presets must be rejected" >&2
    exit 1
fi

version="$(mise_test ls-remote php:minimal | tail -n 1)"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Invalid PHP version returned by the plugin: $version" >&2
    exit 1
fi

mise_test install --force "php:minimal@$version"

install_path="$(mise_test where "php:minimal@$version")"
if [[ ! -x "$install_path/bin/php" ]]; then
    echo "PHP was not installed at $install_path/bin/php" >&2
    exit 1
fi

installed_version="$(mise_test exec "php:minimal@$version" -- php -r 'echo PHP_VERSION;')"
if [[ "$installed_version" != "$version" ]]; then
    echo "Expected PHP $version, got $installed_version" >&2
    exit 1
fi

echo "Installed and executed PHP $installed_version"
