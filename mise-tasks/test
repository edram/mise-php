#!/usr/bin/env bash
#MISE description="Test version discovery, installation, and execution"
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_dir="$(mktemp -d)"
project_dir="$test_dir/project"
trap 'rm -rf "$test_dir"' EXIT

export MISE_CACHE_DIR="$test_dir/cache"
export MISE_CONFIG_DIR="$test_dir/config"
export MISE_DATA_DIR="$test_dir/data"
export MISE_EXPERIMENTAL=1
export MISE_STATE_DIR="$test_dir/state"
export MISE_USE_VERSIONS_HOST=0

lua - "$root_dir" <<'LUA'
local root_dir = assert(arg[1])
PLUGIN = { version = "test" }
local php = dofile(root_dir .. "/lib/php.lua")

assert(php.tag("8.5.9", "cli", "common") == "php-8.5.9-cli-common")
assert(
    php.archive_name("8.5.9", "cli", "common", "linux", "x86_64")
        == "php-8.5.9-cli-common-linux-x86_64.tar.gz"
)

local linux_archive = "php-8.5.9-cli-common-linux-x86_64.tar.gz"
local macos_archive = "php-8.5.9-cli-common-macos-aarch64.tar.gz"
local release = {
    assets = {
        { name = linux_archive, digest = "sha256:" .. string.rep("a", 64) },
        { name = macos_archive, digest = "sha256:" .. string.rep("B", 64) },
        { name = "invalid.tar.gz", digest = "md5:" .. string.rep("c", 32) },
    },
}

assert(php.release_asset_sha256(release, linux_archive) == string.rep("a", 64))
assert(php.release_asset_sha256(release, macos_archive) == string.rep("b", 64))
assert(php.release_asset_sha256(release, "invalid.tar.gz") == nil)
assert(php.release_asset_sha256(release, "missing.tar.gz") == nil)
LUA

mise_without_config() {
    mise --no-config "$@"
}

mise_test() {
    mise -C "$project_dir" "$@"
}

mise_without_config plugins link --force php "$root_dir"

if mise_without_config ls-remote php:unsupported > /dev/null 2>&1; then
    echo "Unsupported PHP tools must be rejected" >&2
    exit 1
fi

mkdir -p "$project_dir"
printf '%s\n' \
    '[tools]' \
    '"php:cli" = { version = "8.5", channel = "minimal" }' \
    > "$project_dir/mise.toml"
mise_test trust

version="$(mise_test ls-remote php:cli | tail -n 1)"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Invalid PHP version returned by the plugin: $version" >&2
    exit 1
fi

mise_test install

install_path="$(mise_test where php:cli)"
if [[ ! -x "$install_path/bin/php" ]]; then
    echo "PHP was not installed at $install_path/bin/php" >&2
    exit 1
fi

installed_version="$(mise_test exec -- php -r 'echo PHP_VERSION;')"
if [[ "$installed_version" != "$version" ]]; then
    echo "Expected PHP $version, got $installed_version" >&2
    exit 1
fi

echo "Installed and executed PHP $installed_version"
